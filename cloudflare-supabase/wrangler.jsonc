{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-de-catalago",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
